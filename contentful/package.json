{
  "name": "contentful-provisioning",
  "version": "1.0.0",
  "private": true,
  "description": "Content model migrations and seed content for the bilingual todo app (see specs/001-bilingual-todo-app/contracts/content-model.md)",
  "scripts": {
    "locales": "node --env-file-if-exists=.env scripts/locales.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env seed/import.mjs",
    "check:translations": "node --env-file-if-exists=.env scripts/check-translations.mjs",
    "test": "node --test tests/**/*.test.mjs"
  },
  "dependencies": {
    "contentful-management": "^12.19.1",
    "contentful-migration": "^5.1.1"
  }
}
